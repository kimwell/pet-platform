{
  "name": "pet-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "check": "pnpm check:repo && pnpm check:web && pnpm check:miniprogram",
    "check:repo": "node scripts/check-repository.mjs && node scripts/check-miniprogram.mjs",
    "check:web": "pnpm --filter @pet/admin-web typecheck && pnpm --filter @pet/admin-web lint && pnpm --filter @pet/admin-web test",
    "check:miniprogram": "pnpm --filter @pet/wechat-miniprogram typecheck && pnpm --filter @pet/wechat-miniprogram lint",
    "build:web": "pnpm --filter @pet/admin-web build",
    "dev:web": "pnpm --filter @pet/admin-web dev",
    "preview:web": "pnpm --filter @pet/admin-web preview",
    "dev:infra": "node scripts/local-infra.mjs start",
    "stop:infra": "node scripts/local-infra.mjs stop",
    "check:infra": "node scripts/local-infra.mjs check",
    "contracts:generate": "node scripts/contracts.mjs generate",
    "contracts:check": "node scripts/contracts.mjs check",
    "contracts:typecheck": "pnpm --filter @pet/api-contracts typecheck",
    "contracts:test": "node --test scripts/contracts.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "openapi-typescript": "7.13.0"
  }
}
