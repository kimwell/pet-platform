          "200",
          "400",
          "401",
          "403",
          "409",
          "422",
          "429",
          "503"
        ],
        "requiredHeaders": [
          "X-CSRF-Token"
        ]
      }
    },
    "/api/admin/auth/logout": {
      "post": {
        "security": [
          {
            "StaffCookie": []
          },
          {
            "StaffToken": []
          }
        ],
        "responses": [
          "200",
          "400",
          "401",
          "403",
          "422",
          "429",
          "503"
        ],
        "requiredHeaders": []
      }
    },
    "/api/admin/auth/me": {
      "get": {
        "security": [
          {
            "StaffCookie": []
          },
          {
            "StaffToken": []
          }
        ],
        "responses": [
          "200",
          "400",
          "401",
          "403",
