  },
  "schemes": {
    "StaffCookie": {
      "description": "生产Cookie；local HTTP使用pet_dev_staff_sid，写请求另需X-CSRF-Token及固定Origin/Referer",
      "in": "cookie",
      "name": "__Secure-pet_staff_sid",
      "type": "apiKey"
    },
    "StaffToken": {
      "description": "Bearer加一个空格再加原始opaque Token；与Cookie不能并存",
      "in": "header",
      "name": "X-Staff-Token",
      "type": "apiKey"
    }
  },
  "schemas": [
    "ApiError",
