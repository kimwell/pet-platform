    "Failure",
    "FieldErrorDetail",
    "Grant",
    "LoginInput",
    "PageQuery",
    "PageResponseFieldErrorDetail",
    "Scope",
    "ScopeData",
    "SelfScope",
    "StoresScope",
    "SuccessCsrfResult",
    "SuccessCurrentIdentity",
    "SuccessFieldErrorDetail",
    "SuccessTokenLoginResult",
    "SuccessVoid",
    "TenantScope",
    "TokenLoginResult",
    "TokenResult"
  ]
