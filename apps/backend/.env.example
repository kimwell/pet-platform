# Java 不自动加载此文件；通过进程环境或外部 Spring 配置注入。
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
PET_PUBLIC_ORIGIN=http://localhost:5173
# prod 必须使用 HTTPS 来源，禁止把 local 配置用于生产。
PET_DATABASE_URL=
PET_DATABASE_USERNAME=
PET_DATABASE_PASSWORD=
# local 默认自动迁移；prod 禁止启动迁移，先使用独立迁移任务。
PET_DATABASE_MIGRATION_ENABLED=true
PET_DATABASE_POOL_MAX=10
PET_DATABASE_POOL_MIN_IDLE=2
PET_DATABASE_CONNECTION_TIMEOUT_MS=5000
# Redis没有主机/凭据回退；命名空间由prefix与可信环境共同组成。
PET_REDIS_HOST=
PET_REDIS_PORT=6379
PET_REDIS_USERNAME=
PET_REDIS_PASSWORD=
PET_REDIS_DATABASE=0
PET_REDIS_PREFIX=pet
PET_REDIS_CONNECT_TIMEOUT=2s
PET_REDIS_TIMEOUT=2s
PET_REDIS_SSL_ENABLED=false
PET_ASYNC_THREADS=2
PET_ASYNC_QUEUE_CAPACITY=32
PET_ASYNC_MAX_SNAPSHOT_AGE=30s
PET_ASYNC_SHUTDOWN_WAIT=5s
