.customer-tab-bar { display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 30; background: #fff; box-sizing: border-box; }
.tab-item { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; min-width: 0; height: 116rpx; margin: 0; padding: 8rpx 0 0; border-radius: 0; background: transparent; color: #9EA3A7; font-size: 24rpx; font-weight: 400; line-height: 34rpx; overflow: visible; box-sizing: border-box; }
.tab-item::after { border: 0; }
.tab-icon { width: 40rpx; height: 40rpx; margin-bottom: 8rpx; }
.tab-selected { color: #C94D1A; font-weight: 600; }
.assistant-bump { position: absolute; bottom: 18rpx; width: 120rpx; height: 120rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; }
.assistant-icon { width: 104rpx; height: 104rpx; }
