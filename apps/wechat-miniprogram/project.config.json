{
  "description": "企业应用原生客户小程序；真实 AppID 在本地私有配置设置",
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "appid": "",
  "projectname": "pet-platform-miniprogram",
  "libVersion": "3.17.2",
  "setting": {
    "es6": true,
    "urlCheck": true,
    "useCompilerPlugins": [
      "typescript"
    ],
    "packNpmManually": true,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./package.json",
        "miniprogramNpmDistDir": "./"
      }
    ]
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
