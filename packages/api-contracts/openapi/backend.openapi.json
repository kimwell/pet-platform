{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "BAD_REQUEST",
              "PAGINATION_INVALID",
              "SORT_INVALID",
              "AUTH_CREDENTIAL_AMBIGUOUS",
              "AUTH_REQUIRED",
              "SESSION_EXPIRED",
              "SESSION_REVOKED",
              "AUTH_DOMAIN_MISMATCH",
              "LOGIN_FAILED",
              "PERMISSION_DENIED",
              "CSRF_INVALID",
              "RESOURCE_NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "NOT_ACCEPTABLE",
              "BUSINESS_STATE_CONFLICT",
              "DUPLICATE_RESOURCE",
              "VERSION_CONFLICT",
              "SESSION_LIMIT_REACHED",
              "IDEMPOTENCY_CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "VALIDATION_FAILED",
              "DATE_RANGE_INVALID",
              "AMOUNT_INVALID",
              "RESULT_TOO_LARGE",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "DEPENDENCY_UNAVAILABLE",
              "CAPABILITY_DISABLED",
              "REQUEST_REJECTED"
            ],
            "type": "string"
          },
          "fieldErrors": {
            "items": {
              "$ref": "#/components/schemas/FieldErrorDetail"
            },
            "minItems": 1,
            "type": "array"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Failure": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          },
          "success": {
            "const": false,
            "type": "boolean"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "error",
          "success",
          "traceId"
        ],
        "type": "object"
      },
      "FieldErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "field",
          "message"
        ],
        "type": "object"
      },
      "PageQuery": {
        "additionalProperties": false,
        "properties": {
          "page": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "page",
          "pageSize"
        ],
        "type": "object"
      },
      "PageResponseFieldErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FieldErrorDetail"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "total": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object"
      },
      "SuccessFieldErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FieldErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "success": {
            "const": true,
            "type": "boolean"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "data",
          "success",
          "traceId"
        ],
        "type": "object"
      },
      "SuccessVoid": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "null"
          },
          "success": {
            "const": true,
            "type": "boolean"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "data",
          "success",
          "traceId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "企业应用公共接口契约",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {}
}
