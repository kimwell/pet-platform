{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "BAD_REQUEST",
              "PAGINATION_INVALID",
              "SORT_INVALID",
              "AUTH_CREDENTIAL_AMBIGUOUS",
              "AUTH_REQUIRED",
              "SESSION_EXPIRED",
              "SESSION_REVOKED",
              "AUTH_DOMAIN_MISMATCH",
              "LOGIN_FAILED",
              "PERMISSION_DENIED",
              "SECURITY_CONFIRMATION_FAILED",
              "PASSWORD_CHANGE_REQUIRED",
              "CSRF_INVALID",
              "RESOURCE_NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "NOT_ACCEPTABLE",
              "BUSINESS_STATE_CONFLICT",
              "DUPLICATE_RESOURCE",
              "VERSION_CONFLICT",
              "SESSION_LIMIT_REACHED",
              "IDEMPOTENCY_CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "VALIDATION_FAILED",
              "DATE_RANGE_INVALID",
              "AMOUNT_INVALID",
              "RESULT_TOO_LARGE",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "DEPENDENCY_UNAVAILABLE",
              "CAPABILITY_DISABLED",
              "REQUEST_REJECTED"
            ],
            "type": "string"
          },
          "fieldErrors": {
            "items": {
              "$ref": "#/components/schemas/FieldErrorDetail"
            },
            "minItems": 1,
            "type": "array"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Failure": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          },
          "success": {
            "const": false,
            "type": "boolean"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "error",
          "success",
          "traceId"
        ],
        "type": "object"
      },
      "FieldErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "field",
          "message"
        ],
        "type": "object"
      },
      "PageQuery": {
        "additionalProperties": false,
        "properties": {
          "page": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "page",
          "pageSize"
        ],
        "type": "object"
      },
      "PageResponseFieldErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FieldErrorDetail"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "total": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object"
      },
      "PageResponseScalarOutput": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScalarOutput"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "total": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object"
      },
      "ScalarInput": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "example": "12.30",
            "pattern": "^(0|[1-9][0-9]{0,16})(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "currency": {
            "enum": [
              "CNY"
            ],
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "occurredAt": {
            "description": "输入必须带Z或offset、最多3位小数；输出UTC且固定3位毫秒",
            "format": "date-time",
            "type": "string"
          },
          "optional": {
            "type": [
              "string",
              "null"
            ]
          },
          "progress": {
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "ratio": {
            "type": "number"
          },
          "requiredNullable": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "OPEN",
              "CLOSED"
            ],
            "type": "string"
          },
          "version": {
            "description": "非负Long，最大9223372036854775807",
            "maxLength": 19,
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency",
          "date",
          "enabled",
          "id",
          "items",
          "occurredAt",
          "progress",
          "ratio",
          "requiredNullable",
          "state",
          "version"
        ],
        "type": "object"
      },
      "ScalarOutput": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "example": "12.30",
            "pattern": "^(0|[1-9][0-9]{0,16})\\.[0-9]{2}$",
            "type": "string"
          },
          "currency": {
            "enum": [
              "CNY"
            ],
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "occurredAt": {
            "description": "输入必须带Z或offset、最多3位小数；输出UTC且固定3位毫秒",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
            "type": "string"
          },
          "optional": {
            "type": "string"
          },
          "progress": {
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "ratio": {
            "type": "number"
          },
          "requiredNullable": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "OPEN",
              "CLOSED"
            ],
            "type": "string"
          },
          "version": {
            "description": "非负Long，最大9223372036854775807",
            "maxLength": 19,
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency",
          "date",
          "enabled",
          "id",
          "items",
          "occurredAt",
          "progress",
          "ratio",
          "requiredNullable",
          "state",
          "version"
        ],
        "type": "object"
      },
      "SuccessFieldErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FieldErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "success": {
            "const": true,
            "type": "boolean"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "data",
          "success",
          "traceId"
        ],
        "type": "object"
      },
      "SuccessPageResponseScalarOutput": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PageResponseScalarOutput"
              },
              {
                "type": "null"
              }
            ]
          },
          "success": {
            "const": true,
            "type": "boolean"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "data",
          "success",
          "traceId"
        ],
        "type": "object"
      },
      "SuccessScalarOutput": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScalarOutput"
              },
              {
                "type": "null"
              }
            ]
          },
          "success": {
            "const": true,
            "type": "boolean"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "data",
          "success",
          "traceId"
        ],
        "type": "object"
      },
      "SuccessVoid": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "null"
          },
          "success": {
            "const": true,
            "type": "boolean"
          },
          "traceId": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "data",
          "success",
          "traceId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "PlatformCookie": {
        "description": "仅PLATFORM WEB；写请求必须独立CSRF及同源来源",
        "in": "cookie",
        "name": "__Secure-pet_platform_sid",
        "type": "apiKey"
      },
      "StaffCookie": {
        "description": "生产Cookie；local HTTP使用pet_dev_staff_sid，写请求另需X-CSRF-Token及固定Origin/Referer",
        "in": "cookie",
        "name": "__Secure-pet_staff_sid",
        "type": "apiKey"
      },
      "StaffToken": {
        "description": "Bearer加一个空格再加原始opaque Token；与Cookie不能并存",
        "in": "header",
        "name": "X-Staff-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "企业应用公共接口契约",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/__contracts/error": {
      "get": {
        "operationId": "testSafeError",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessVoid"
                }
              }
            },
            "description": "成功"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "请求格式错误"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "输入语义校验失败"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "安全内部错误"
          }
        },
        "tags": [
          "contract-controller"
        ]
      }
    },
    "/__contracts/null": {
      "get": {
        "operationId": "testNullSuccess",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessVoid"
                }
              }
            },
            "description": "成功"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "请求格式错误"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "输入语义校验失败"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "安全内部错误"
          }
        },
        "tags": [
          "contract-controller"
        ]
      }
    },
    "/__contracts/page": {
      "get": {
        "operationId": "testScalarPage",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessPageResponseScalarOutput"
                }
              }
            },
            "description": "成功"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "请求格式错误"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "输入语义校验失败"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "安全内部错误"
          }
        },
        "tags": [
          "contract-controller"
        ]
      }
    },
    "/__contracts/scalars": {
      "post": {
        "operationId": "testEchoScalars",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScalarInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessScalarOutput"
                }
              }
            },
            "description": "成功"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "请求格式错误"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "输入语义校验失败"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "安全内部错误"
          }
        },
        "tags": [
          "contract-controller"
        ]
      }
    }
  }
}
